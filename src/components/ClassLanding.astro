---
// Shared template for the dedicated class landing pages (one page per bookable
// experience / search intent). Each page under src/pages/ supplies the copy;
// this component renders the sections and emits the page-level JSON-LD
// (Product or Service, BreadcrumbList, FAQPage). Sitewide LocalBusiness
// schema still comes from Schema.astro via the layout.
import { Image } from 'astro:assets';
import { localizePath } from '../i18n/utils';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/config';
import { shapesHubPath } from '../data/shapes';
import type { FactIcon } from '../data/landings';

interface Fact {
  label: string;
  value: string;
  icon?: FactIcon;
}

// Original line-icon set (24x24, stroke-based, warm single-color) — hand-drawn
// for this site, not sourced or traced from any third party.
const FACT_ICONS: Record<FactIcon, string> = {
  clock:
    '<circle cx="12" cy="12" r="8.5"/><path d="M12 3.3v1.4M20.7 12h-1.4M12 20.7v-1.4M3.3 12h1.4"/><path d="M12 7.5V12l3 2"/>',
  people:
    '<circle cx="8.5" cy="8" r="3"/><path d="M2.8 19.5c0-3.4 2.6-6 5.7-6s5.7 2.6 5.7 6"/><circle cx="16.7" cy="9" r="2.3"/><path d="M15.2 13.3c2.6.4 4.5 2.5 4.7 5.5"/>',
  calendar:
    '<rect x="3.2" y="5" width="17.6" height="15.5" rx="2.2"/><path d="M3.2 9.8h17.6M8 3v4M16 3v4"/><circle cx="12" cy="14.7" r="1.2" fill="currentColor" stroke="none"/>',
  'map-pin':
    '<path d="M12 21.3S5 14.4 5 9.6a7 7 0 1 1 14 0c0 4.8-7 11.7-7 11.7z"/><circle cx="12" cy="9.6" r="2.6"/>',
  globe:
    '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.3 2.5 2.3 14.5 0 17M12 3.5c-2.3 2.5-2.3 14.5 0 17"/>',
  leaf:
    '<path d="M4.7 20.4c8 .8 13.1-3.8 13.6-12.2l.2-2.9-3 .1C7.2 5.7 3.9 11 4.7 20.4z"/><path d="M4.9 20.2c2-4.6 5.6-8.2 11.4-10.5"/>',
  'chef-hat':
    '<path d="M8.6 20.5h6.8M9.3 20.5v-5.6M14.7 20.5v-5.6M6.3 9.7a4.2 4.2 0 0 1 4.1-4.3c.3-1 1.1-1.6 2.1-1.6.9 0 1.7.6 2.1 1.5a4.2 4.2 0 0 1 4.4 4.2c0 2-1.6 3.8-3.3 4.5v1.5H9.6v-1.5c-1.7-.7-3.3-2.4-3.3-4.3z"/>',
  home:
    '<path d="M3.5 11.2L12 4l8.5 7.2"/><path d="M5.5 10v10.5h13V10"/><path d="M9.7 20.5v-5.3h4.6v5.3"/>',
  laptop:
    '<rect x="4" y="5" width="16" height="10" rx="1.6"/><path d="M7 8.5h10M7 11.3h6"/><path d="M2 19.3h20l-2 1.2H4z"/>',
  package:
    '<path d="M3 8l9-5 9 5-9 5-9-5z"/><path d="M3 8v9l9 5 9-5V8"/><path d="M12 13v9M3 8l9 5 9-5"/>',
  table:
    '<path d="M3.2 6.2h17.6v3.2H3.2z"/><path d="M5.4 9.4v10.6M18.6 9.4v10.6"/>',
  gift:
    '<rect x="4" y="9.5" width="16" height="10.7" rx="1.2"/><path d="M4 9.5h16M12 9.5v10.7"/><path d="M12 9.5c-3.2.3-5-1.8-4.6-3.6.3-1.5 2-2.1 3.2-1.2 1 .8 1.4 2.6 1.4 4.8zM12 9.5c3.2.3 5-1.8 4.6-3.6-.3-1.5-2-2.1-3.2-1.2-1 .8-1.4 2.6-1.4 4.8z"/>',
  tag:
    '<path d="M3 12.3L12.3 3h6.7v6.7L9.7 19z"/><circle cx="15.7" cy="7.3" r="1.5" fill="currentColor" stroke="none"/>',
  mail:
    '<rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/>',
};
interface Section {
  title: string;
  paras: string[];
  list?: string[];
}
interface Faq {
  q: string;
  a: string;
}
interface Related {
  title: string;
  href: string;
  desc: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  headingItal: string;
  lede: string;
  image: { src: ImageMetadata; alt: string; w: number; h: number };
  price: string;
  priceNote?: string;
  facts: Fact[];
  sections: Section[];
  faqs: Faq[];
  related: Related[];
  ctaLabel: string;
  /** Booking-drawer prefill; ignored when emailSubject is set. */
  prefill?: 'florence' | 'online';
  /** When set, the CTA becomes a mailto (bespoke enquiries) instead of the drawer. */
  emailSubject?: string;
  breadcrumbName: string;
  /** When true, inserts a "Pasta" crumb (linking to the pasta-shapes hub) between Home and breadcrumbName. */
  showPastaCrumb?: boolean;
  /** Product schema (classes with a fixed per-person/per-group price). */
  product?: { name: string; description: string; price: string };
  /** Service schema (bespoke offers without a public price). */
  service?: { name: string; description: string };
  /** Rendering locale (passed by the landing route; falls back to the URL). */
  locale?: Locale;
  /** Set by the route from the pageKey's landings.ts entry — see LandingPage.courseMode. */
  courseMode?: 'Onsite' | 'Online';
  /** ISO 8601 duration, from LandingPage.courseDuration — omitted where the copy doesn't state a fixed length. */
  courseDuration?: string;
}

const {
  eyebrow,
  heading,
  headingItal,
  lede,
  image,
  price,
  priceNote,
  facts,
  sections,
  faqs,
  related,
  ctaLabel,
  prefill = 'florence',
  emailSubject,
  breadcrumbName,
  showPastaCrumb = false,
  product,
  service,
  locale,
  courseMode,
  courseDuration,
} = Astro.props;

const lang = (locale || (Astro.currentLocale as Locale) || 'en') as Locale;
const t = useTranslations(lang);

const SITE = 'https://handmadepastaflorence.com';
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Rolling year-end validity, same policy as the homepage Offers in Schema.astro.
const PRICE_VALID_UNTIL = '2026-12-31';

const productSchema = product && {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  image: `${SITE}${image.src.src}`,
  brand: { '@type': 'Brand', name: 'Handmade Pasta Florence' },
  offers: {
    '@type': 'Offer',
    price: product.price,
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    priceValidUntil: PRICE_VALID_UNTIL,
    url: canonical,
  },
};

// Course schema, additive to Product — separate rich-result surface for the
// same offering. Derived from `product` (no separate content to maintain);
// only emitted where courseMode is set (see LandingPage.courseMode).
const courseSchema = product && courseMode && {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: product.name,
  description: product.description,
  image: `${SITE}${image.src.src}`,
  provider: { '@type': 'Organization', name: 'Handmade Pasta Florence', sameAs: SITE },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode,
    ...(courseDuration ? { duration: courseDuration } : {}),
    ...(courseMode === 'Onsite'
      ? {
          location: {
            '@type': 'Place',
            name: 'Handmade Pasta Florence',
            address: { '@type': 'PostalAddress', addressLocality: 'Firenze', addressCountry: 'IT' },
          },
        }
      : {}),
    offers: {
      '@type': 'Offer',
      price: product.price,
      priceCurrency: 'EUR',
      availability: 'https://schema.org/InStock',
      priceValidUntil: PRICE_VALID_UNTIL,
      url: canonical,
    },
  },
};

const serviceSchema = service && {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.description,
  provider: { '@id': `${SITE}/#business` },
  areaServed: { '@type': 'City', name: 'Florence' },
  url: canonical,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: showPastaCrumb
    ? [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: t.lp.pastaCrumb, item: `${SITE}${shapesHubPath(lang)}` },
        { '@type': 'ListItem', position: 3, name: breadcrumbName, item: canonical },
      ]
    : [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: breadcrumbName, item: canonical },
      ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<!-- id="top" lets FloatingCTA treat this hero like the homepage one -->
<section class="lp-hero" id="top">
  <div class="shell lp-hero__inner">
    <div class="lp-hero__text" data-reveal>
      <nav class="lp-crumb" aria-label="Breadcrumb">
        <a href={localizePath('/', lang)}>{t.lp.home}</a> <span aria-hidden="true">&gt;</span>
        {showPastaCrumb && (
          <>
            <a href={shapesHubPath(lang)}>{t.lp.pastaCrumb}</a> <span aria-hidden="true">&gt;</span>
          </>
        )}
        <span>{breadcrumbName}</span>
      </nav>
      <p class="eyebrow lp-hero__eyebrow">{eyebrow}</p>
      <h1 class="lp-hero__h">
        {heading} <span class="ital">{headingItal}</span>
      </h1>
      <p class="lp-hero__lede">{lede}</p>
      <div class="lp-hero__row">
        {
          emailSubject ? (
            <a
              class="lp-hero__cta"
              href={`mailto:ciao@handmadepastaflorence.com?subject=${encodeURIComponent(emailSubject)}`}
            >
              {ctaLabel} <span aria-hidden="true">→</span>
            </a>
          ) : (
            <button class="lp-hero__cta" data-open-booking data-cta="landing-hero" data-prefill={prefill}>
              {ctaLabel} <span aria-hidden="true">→</span>
            </button>
          )
        }
        <span class="lp-hero__price">
          <strong>{price}</strong>
          {priceNote && <small>{priceNote}</small>}
        </span>
      </div>
    </div>
    <div class="lp-hero__media" data-reveal style="--reveal-delay:120ms">
      <Image src={image.src} alt={image.alt} width={image.w} height={image.h} loading="eager" decoding="async" />
    </div>
  </div>
</section>

<section class="lp-facts">
  <div class="shell">
    <dl class="lp-facts__grid" data-reveal>
      {
        facts.map((f) => (
          <div class="lp-facts__item">
            {f.icon && (
              <svg class="lp-facts__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={FACT_ICONS[f.icon]} />
            )}
            <div class="lp-facts__text">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<section class="lp-body">
  <div class="shell lp-body__inner">
    {
      sections.map((s, i) => (
        <article class="lp-sec" data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <h2 class="lp-sec__h">{s.title}</h2>
          {s.paras.map((p) => (
            <p class="lp-sec__p" set:html={p} />
          ))}
          {s.list && (
            <ul class="lp-sec__list">
              {s.list.map((li) => (
                <li set:html={li} />
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>
</section>

<section class="lp-faq">
  <div class="shell lp-faq__inner">
    <h2 class="lp-faq__h">{t.lp.faqPre}<span class="ital">{t.lp.faqItal}</span></h2>
    <div class="lp-faq__list">
      {
        faqs.map((f, i) => (
          <details class="lp-faq__item" data-reveal style={`--reveal-delay:${i * 50}ms`}>
            <summary class="lp-faq__q">
              {f.q}
              <span class="lp-faq__icon" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="lp-faq__a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section class="lp-rel">
  <div class="shell">
    <h2 class="lp-rel__h">{t.lp.relPre}<span class="ital">{t.lp.relItal}</span></h2>
    <div class="lp-rel__grid">
      {
        related.map((r, i) => (
          <a class="lp-rel__card" href={r.href} data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <h3>{r.title}</h3>
            <p>{r.desc}</p>
            <span class="lp-rel__go" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

{productSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />}
{courseSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />}
{serviceSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />}
<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  /* ===== Hero ===== */
  .lp-hero {
    background: var(--olive-deep);
    color: var(--flour);
    padding-block: clamp(7rem, 16vh, 10rem) clamp(3rem, 7vh, 5rem);
    position: relative;
    overflow: hidden;
  }
  .lp-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(55% 70% at 85% 15%, rgba(255, 199, 44, 0.12), transparent 70%);
  }
  .lp-hero__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    grid-template-columns: 1fr;
    position: relative;
  }
  @media (min-width: 860px) {
    .lp-hero__inner {
      grid-template-columns: 1.25fr 1fr;
    }
  }
  .lp-crumb {
    font-size: var(--step--1);
    color: rgba(249, 246, 240, 0.55);
    margin-bottom: 1.4rem;
  }
  .lp-crumb a {
    color: rgba(249, 246, 240, 0.75);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.3s;
  }
  .lp-crumb a:hover {
    color: var(--flour);
  }
  .lp-crumb span[aria-hidden] {
    margin-inline: 0.4rem;
  }
  .lp-hero__eyebrow {
    color: var(--yolk);
    margin-bottom: 1rem;
  }
  .lp-hero__h {
    font-size: var(--step-3);
    line-height: 1.08;
    max-width: 18ch;
  }
  .lp-hero__h .ital {
    color: var(--yolk);
  }
  .lp-hero__lede {
    margin-top: 1.2rem;
    color: rgba(249, 246, 240, 0.82);
    font-size: var(--step-0);
    line-height: 1.65;
    max-width: 54ch;
  }
  .lp-hero__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.6rem;
    margin-top: 1.8rem;
  }
  .lp-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--yolk);
    color: var(--olive-deep);
    font-weight: 800;
    font-size: var(--step-0);
    padding: 0.95rem 1.6rem;
    border-radius: 100px;
    box-shadow: 0 10px 26px -10px rgba(240, 180, 0, 0.75);
    transition: gap 0.3s;
  }
  .lp-hero__cta:hover {
    gap: 1rem;
  }
  .lp-hero__price {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .lp-hero__price strong {
    font-family: var(--serif);
    font-size: var(--step-1);
    color: var(--flour);
  }
  .lp-hero__price small {
    font-size: var(--step--1);
    color: rgba(249, 246, 240, 0.65);
  }
  .lp-hero__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    aspect-ratio: 4 / 3;
    background: var(--olive);
  }
  @media (min-width: 860px) {
    .lp-hero__media {
      aspect-ratio: 5 / 4;
    }
  }
  .lp-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ===== Facts strip ===== */
  .lp-facts {
    background: var(--flour);
    border-bottom: 1px solid var(--paper-line);
  }
  .lp-facts__grid {
    display: grid;
    gap: 1.4rem 1.2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
    padding-block: clamp(1.6rem, 4vw, 2.4rem);
  }
  /* From here up, force every fact onto a single row instead of letting a
     narrow container wrap the last item — the item count varies per page
     (6-7), so this uses equal flexible columns rather than a fixed count. */
  @media (min-width: 1024px) {
    .lp-facts__grid {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }
  }
  .lp-facts__item {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
  }
  .lp-facts__icon {
    flex-shrink: 0;
    width: 2.1rem;
    height: 2.1rem;
    margin-top: 0.05rem;
    color: var(--terracotta);
  }
  .lp-facts__item dt {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--terracotta);
  }
  .lp-facts__item dd {
    margin-top: 0.3rem;
    font-family: var(--serif);
    font-weight: 700;
    font-size: var(--step-0);
    color: var(--olive);
  }

  /* ===== Body prose ===== */
  .lp-body {
    padding-block: clamp(3.5rem, 9vh, 6rem);
  }
  .lp-body__inner {
    display: grid;
    gap: clamp(2.4rem, 5vw, 3.4rem);
    max-width: 820px;
  }
  .lp-sec__h {
    font-size: var(--step-2);
    color: var(--olive);
    margin-bottom: 0.9rem;
  }
  .lp-sec__p {
    color: var(--charcoal);
    line-height: 1.7;
    font-size: var(--step-0);
    max-width: 66ch;
  }
  .lp-sec__p + .lp-sec__p {
    margin-top: 0.9rem;
  }
  .lp-sec__p :global(a),
  .lp-sec__list :global(a) {
    color: var(--terracotta);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .lp-sec__list {
    margin-top: 1rem;
    display: grid;
    gap: 0.55rem;
  }
  .lp-sec__list li {
    position: relative;
    padding-left: 1.3rem;
    color: var(--charcoal);
    line-height: 1.6;
    font-size: var(--step-0);
    max-width: 64ch;
  }
  .lp-sec__list li::before {
    content: '·';
    position: absolute;
    left: 0.25rem;
    color: var(--terracotta);
    font-weight: 800;
  }

  /* ===== FAQ ===== */
  .lp-faq {
    background: var(--flour);
    padding-block: clamp(3rem, 8vh, 5rem);
  }
  .lp-faq__h {
    font-size: var(--step-2);
    color: var(--olive);
    margin-bottom: clamp(1.6rem, 3vw, 2.4rem);
  }
  .lp-faq__h .ital {
    color: var(--terracotta);
  }
  .lp-faq__list {
    display: grid;
    gap: 0.8rem;
    max-width: 760px;
  }
  .lp-faq__item {
    background: #fff;
    border: 1px solid var(--paper-line);
    border-radius: var(--radius);
    padding: 0 1.3rem;
    box-shadow: var(--shadow-sm);
  }
  .lp-faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    padding: 1.1rem 0;
    font-family: var(--serif);
    font-weight: 700;
    font-size: var(--step-0);
    color: var(--olive);
  }
  .lp-faq__q::-webkit-details-marker {
    display: none;
  }
  .lp-faq__icon {
    color: var(--terracotta);
    font-size: 1.4rem;
    line-height: 1;
    flex-shrink: 0;
    transition: transform 0.3s var(--ease);
  }
  .lp-faq__item[open] .lp-faq__icon {
    transform: rotate(45deg);
  }
  .lp-faq__a {
    margin: 0 0 1.2rem;
    color: var(--charcoal);
    line-height: 1.6;
    font-size: var(--step--1);
    max-width: 64ch;
  }

  /* ===== Related ===== */
  .lp-rel {
    padding-block: clamp(3rem, 8vh, 5rem);
  }
  .lp-rel__h {
    font-size: var(--step-2);
    color: var(--olive);
    margin-bottom: clamp(1.6rem, 3vw, 2.4rem);
  }
  .lp-rel__h .ital {
    color: var(--terracotta);
  }
  .lp-rel__grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.6rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
  }
  .lp-rel__card {
    position: relative;
    display: block;
    background: #fff;
    border: 1px solid var(--paper-line);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.5rem 1.6rem;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .lp-rel__card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
