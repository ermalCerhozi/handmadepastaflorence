---
// FAQ section — answers common booking questions and feeds FAQPage schema.
// Every answer is grounded in facts already published elsewhere on the site.
// Cancellation policy confirmed by the owner 2026-09-03 (48h free cancel/reschedule
// window, see cancelFaq in each locale). The payment answer restates the booking
// policy page (payFaq); the exact-address answer is still pending.
import { getLocaleFromUrl } from '../i18n/utils';
import { useTranslations } from '../i18n/ui';
import { faqSchema } from '../utils/schema';
const t = useTranslations(getLocaleFromUrl(Astro.url));
const faqs = t.faq.items;

---

<section class="faq" id="faq">
  <div class="shell faq__inner">
    <header class="faq__head" data-reveal>
      <p class="eyebrow faq__eyebrow">{t.faq.eyebrow}</p>
      <h2 class="faq__title">{t.faq.titlePre} <span class="font-golden font-golden--accent font-golden--wide font-golden--terracotta">{t.faq.titleItal}</span></h2>
    </header>

    <div class="faq__list">
      {faqs.map((f, i) => (
        <div class="faq__item" data-reveal style={`--reveal-delay:${i * 50}ms`}>
          <h3 class="faq__q">{f.q}</h3>
          <p class="faq__a">{f.a}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema(faqs))} />

<style>
  .faq { padding-block: var(--section-sm); background: var(--flour); }
  .faq__head { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .faq__eyebrow { color: var(--terracotta); margin-bottom: 0.7rem; }
  .faq__title { font-size: var(--step-3); color: var(--olive); }

  .faq__list { display: grid; gap: 0.8rem; max-width: 760px; }
  .faq__item {
    background: #fff; border: 1px solid var(--paper-line); border-radius: var(--radius);
    padding: 0 1.3rem; box-shadow: var(--shadow-sm);
  }
  /* Always open: the homepage is the main search landing page, and answers in
     plain view do better than ones folded behind a click. */
  .faq__q {
    padding: 1.1rem 0 0.5rem;
    font-family: var(--serif); font-weight: 700; font-size: var(--step-0); color: var(--olive);
  }
  .faq__a {
    margin: 0 0 1.2rem; color: var(--charcoal); line-height: 1.6;
    font-size: var(--step--1); max-width: 64ch;
  }
</style>
