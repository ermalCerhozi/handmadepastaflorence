---
import { getLocaleFromUrl, localizePath } from '../i18n/utils';
import { useTranslations } from '../i18n/ui';
import { landingPath } from '../data/landings';
import { classesPath } from '../data/classes-hub';
import { shapesHubPath } from '../data/shapes';
import { PHONE_DISPLAY, TEL_URL, WHATSAPP_URL, WHATSAPP_ICON_PATH, MAILTO } from '../data/contact';
const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizePath('/', lang);
const year = new Date().getFullYear();
---

<footer class="ft">
  <div class="shell">
    <div class="ft__cta" data-reveal>
      <h2 class="ft__h" set:html={t.footer.headline} />
      <button class="ft__btn" data-open-booking data-cta="footer">
        {t.footer.book}
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

    <div class="ft__grid">
      <div class="ft__brand">
        <span class="ft__name"><strong>Handmade Pasta</strong> <span class="font-golden font-golden--mark">Florence</span></span>
        <p>Via dei Pastai 12, Oltrarno · Firenze, Italy</p>
        <p><a href={TEL_URL}>{PHONE_DISPLAY}</a></p>
        <p>{t.footer.hours}</p>
        <p>{t.footer.desc}</p>
        <p class="ft__chefs">{t.footer.by} <a href="https://endricerhozi.com" target="_blank" rel="noopener">Endri Cerhozi</a> &amp; <span>Marsel</span></p>
      </div>
      <nav class="ft__col">
        <h3>{t.footer.classes}</h3>
        <a href={classesPath(lang)}>{t.exp.allClasses}</a>
        <a href={landingPath('pasta-making', lang)}>{t.footer.pastaClass}</a>
        <a href={landingPath('market-tour', lang)}>{t.footer.marketTour}</a>
        <a href={landingPath('agriturismo', lang)}>{t.footer.agriturismo}</a>
        <a href={landingPath('private', lang)}>{t.footer.private}</a>
        <a href={landingPath('online', lang)}>{t.footer.online}</a>
        <a href={landingPath('gluten-free', lang)}>{t.footer.glutenFree}</a>
        <a href={landingPath('vegan', lang)}>{t.footer.vegan}</a>
        <a href={landingPath('for-two', lang)}>{t.footer.forTwo}</a>
        <a href={landingPath('family', lang)}>{t.footer.family}</a>
        <a href={landingPath('team-building', lang)}>{t.footer.team}</a>
        <a href={landingPath('gift', lang)}>{t.footer.gift}</a>
      </nav>
      <nav class="ft__col">
        <h3>{t.footer.visit}</h3>
        <a href={`${home}#story`}>{t.nav.story}</a>
        <a href={shapesHubPath(lang)}>{t.nav.pasta}</a>
        <a href={localizePath('/blog/', lang)}>{t.footer.guides}</a>
        <a href={`${home}#business`}>{t.nav.business}</a>
        <a href={`${home}#faq`}>{t.footer.faq}</a>
        <a href={MAILTO}>ciao@…florence.com</a>
        <a class="ft__wa" href={WHATSAPP_URL} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d={WHATSAPP_ICON_PATH}/></svg>
          {PHONE_DISPLAY}
        </a>
      </nav>
      {/* English-only on purpose, regardless of site locale — these pages
          themselves are never translated (see infoPages in i18n/config.ts),
          so a translated label promising translated content would mislead. */}
      <nav class="ft__col">
        <h3>Information</h3>
        <a href="/booking-policy/">Booking Policy</a>
        <a href="/cancellation-policy/">Cancellation & Refund</a>
        <a href="/terms-and-conditions/">Terms & Conditions</a>
        <a href="/privacy/">Privacy</a>
        <a href="/safety-insurance/">Safety & Insurance</a>
      </nav>
    </div>

    <div class="ft__base">
      <span>© {year} Handmade Pasta Florence</span>
      <span class="ft__made">{t.footer.made}</span>
    </div>
  </div>
</footer>

<style>
  .ft { background: var(--olive-deep); color: var(--flour); padding-block: var(--section-sm) 2rem; }
  .ft__cta {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2rem;
    padding-bottom: clamp(2.5rem, 6vw, 4rem); border-bottom: 1px solid rgba(249,246,240,0.14);
  }
  .ft__h { font-size: var(--step-3); }
  .ft__btn {
    display: inline-flex; align-items: center; gap: 0.6rem; background: var(--yolk); color: var(--olive-deep);
    font-weight: 800; font-size: var(--step-0); padding: 1rem 1.7rem; border-radius: 100px;
    transition: gap 0.3s;
  }
  .ft__btn:hover { gap: 1rem; }

  .ft__grid {
    display: grid; gap: 2rem; padding-block: clamp(2.5rem, 6vw, 4rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
  }
  .ft__name { font-family: var(--serif); font-size: 1.5rem; }
  .ft__name strong { font-weight: 800; } .ft__name em { font-style: italic; opacity: 0.85; }
  .ft__brand p { color: rgba(249,246,240,0.6); font-size: var(--step--1); margin-top: 0.6rem; max-width: 30ch; }
  .ft__brand a { color: rgba(249,246,240,0.85); text-decoration: underline; text-underline-offset: 2px; transition: color 0.3s; }
  .ft__brand a:hover { color: var(--flour); }
  .ft__chefs span { color: rgba(249,246,240,0.85); }
  .ft__col h3 { font-family: var(--sans); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--yolk); margin-bottom: 1rem; }
  .ft__col a { display: block; color: rgba(249,246,240,0.78); font-size: var(--step--1); padding-block: 0.35rem; transition: color 0.3s, padding-left 0.3s; }
  .ft__col a:hover { color: var(--flour); padding-left: 6px; }
  .ft__wa { display: inline-flex; align-items: center; gap: 0.45rem; }
  .ft__wa svg { color: #25D366; flex-shrink: 0; }

  .ft__base {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem;
    padding-top: 2rem; border-top: 1px solid rgba(249,246,240,0.14);
    font-size: 0.78rem; color: rgba(249,246,240,0.5);
  }
  .ft__base a { color: rgba(249,246,240,0.7); text-decoration: underline; text-underline-offset: 2px; transition: color 0.3s; }
  .ft__base a:hover { color: var(--flour); }
  .ft__made { color: var(--yolk); }
</style>
