---
// Seasonal Christmas push for the gift-voucher landing: a slim band in the same
// shape as OnlineBand, dressed as a voucher (dashed inner edge) in terracotta.
import { getLocaleFromUrl } from '../i18n/utils';
import { useTranslations } from '../i18n/ui';
import { landingPath } from '../data/landings';
const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);

// WHY: the site is static, so this is checked at build time (UTC date). The band
// hides itself on the first deploy after Christmas Eve and stays hidden; in
// January delete this component (and its <GiftBand /> in HomePage.astro and the
// `giftBand` strings) or re-date it for next season.
const GIFT_SEASON_END = '2026-12-24';
const inSeason = new Date().toISOString().slice(0, 10) <= GIFT_SEASON_END;
---

{inSeason && (
<section class="gb" id="gift">
  <div class="shell">
    <div class="gb__inner" data-reveal>
      <div class="gb__text">
        <p class="eyebrow gb__eyebrow">{t.giftBand.eyebrow}</p>
        <h2 class="gb__title">{t.giftBand.titlePre}<span class="font-golden font-golden--accent font-golden--yolk">{t.giftBand.titleItal}</span></h2>
        <p class="gb__desc">{t.giftBand.desc}</p>
      </div>
      <a class="gb__cta" href={landingPath('gift', lang)}>
        {t.giftBand.cta} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
)}

<style>
  /* No top padding: .exp above already ends on a deep bottom pad. */
  .gb { padding-bottom: clamp(3rem, 8vh, 5.5rem); }
  .gb__inner {
    display: grid; gap: 1.4rem 3rem; align-items: center;
    grid-template-columns: 1fr;
    background: var(--terracotta-deep); color: var(--flour);
    border-radius: var(--radius-lg); padding: clamp(1.6rem, 4vw, 2.6rem);
    box-shadow: var(--shadow-md); position: relative; overflow: hidden;
  }
  .gb__inner::before {
    content: ''; position: absolute; inset: 0; opacity: 0.6; pointer-events: none;
    background: radial-gradient(55% 90% at 88% 20%, rgba(255,199,44,0.18), transparent 70%);
  }
  .gb__inner::after {
    content: ''; position: absolute; inset: 10px; pointer-events: none;
    border: 1.5px dashed rgba(249,246,240,0.3); border-radius: calc(var(--radius-lg) - 10px);
  }
  @media (min-width: 820px) { .gb__inner { grid-template-columns: 1fr auto; } }

  .gb__text { position: relative; }
  .gb__eyebrow { color: var(--yolk); margin-bottom: 0.7rem; }
  .gb__title { font-size: var(--step-2); }
  .gb__desc { margin-top: 0.8rem; color: rgba(249,246,240,0.85); font-size: var(--step--1); line-height: 1.6; max-width: 60ch; }
  .gb__cta {
    position: relative; justify-self: start;
    display: inline-flex; align-items: center; gap: 0.5rem; background: var(--yolk); color: var(--olive-deep);
    font-weight: 800; padding: 0.8rem 1.4rem; border-radius: 100px; transition: gap 0.3s;
  }
  @media (hover: hover) {
    .gb__cta:hover { gap: 0.9rem; }
  }
</style>
