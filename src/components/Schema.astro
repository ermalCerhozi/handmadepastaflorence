---
// Sitewide structured data (JSON-LD).
//
// The address/phone below mirror the NAP shown on the page. Before relying on
// these for local SEO, confirm they are the real, registered business details
// and add `geo` coordinates + `sameAs` social/GBP links — see
// REMAINING-SEO-TASKS.md (items needing owner input).
import { cookingClass } from '../assets/images';
import { getAggregateRating, getReviewSchema } from '../data/reviews';
import { landings, landingPath, type LandingKey, type LandingPage } from '../data/landings';
import { getLocaleFromUrl } from '../i18n/utils';
import { defaultLocale, locales } from '../i18n/config';
import { PRICE_VALID_UNTIL } from '../utils/offer-validity';

const SITE = 'https://handmadepastaflorence.com';

// Sitewide, unscoped: this rates the business as a whole, which is exactly
// what LocalBusiness should carry. Per-class ratings are resolved per Product.
const aggregateRating = getAggregateRating();

const localBusiness = {
  '@context': 'https://schema.org',
  // Dual-typed: a bookable cooking-class kitchen is both a local business and
  // a tourist activity — Google's TouristAttraction docs endorse combining the two.
  '@type': ['LocalBusiness', 'TouristAttraction'],
  '@id': `${SITE}/#business`,
  name: 'Handmade Pasta Florence',
  description:
    'Hands-on fresh-pasta cooking classes in Florence taught by two agriturismo head chefs: in person in the Oltrarno and live online with a shipped ingredient kit.',
  founder: [
    {
      '@type': 'Person',
      name: 'Endri Cerhozi',
      jobTitle: 'Head Chef',
      // Full entity graph, not just the domain. Three of the top five AI-visibility
      // factors are citation/entity signals, and these are the only externally
      // verifiable profiles this business can point at until it has its own.
      // Mirrors the sameAs already published on endricerhozi.com — keep in sync.
      sameAs: [
        'https://endricerhozi.com',
        'https://www.instagram.com/endricerhozi/',
        'https://www.facebook.com/endricerhozi/',
        'https://www.linkedin.com/in/endri-cerhozi/',
      ],
    },
    { '@type': 'Person', name: 'Marsel', jobTitle: 'Head Chef' },
  ],
  url: SITE,
  image: `${SITE}${cookingClass.src}`,
  email: 'ciao@handmadepastaflorence.com',
  telephone: '+393445204379',
  priceRange: '€€',
  // Google requires an Organization/LocalBusiness logo to be at least
  // 112x112. public/images/logo.png is 80x80 and is deliberately small - it is
  // the 40x40 header mark in Header.astro - so this points at the 180x180
  // apple-touch-icon, which is the same artwork and the only copy in the repo
  // that clears the minimum. Both live in public/ at stable un-hashed URLs
  // because crawlers need them not to change on every build.
  logo: {
    '@type': 'ImageObject',
    url: `${SITE}/apple-touch-icon.png`,
    width: 180,
    height: 180,
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Via dei Pastai 12',
    addressLocality: 'Firenze',
    addressRegion: 'FI',
    // 50125 is the CAP for the Oltrarno / Piazza Santo Spirito zone. INFERRED
    // from the neighbourhood, not read off a document — 50124 covers part of
    // the same area. Confirm against the actual address before building any
    // citations (Yelp, Apple, Bing Places), because every one of them has to
    // match this exactly or the NAP signal splits.
    postalCode: '50125',
    addressCountry: 'IT',
  },
  areaServed: [
    { '@type': 'City', name: 'Florence' },
    { '@type': 'Place', name: 'Tuscany, Italy' },
  ],
  availableLanguage: [
    { '@type': 'Language', name: 'English' },
    { '@type': 'Language', name: 'Italian' },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '10:00',
      closes: '21:00',
    },
  ],
  // Empty while src/data/reviews.ts has no entries; emits automatically once
  // real guest reviews are added there. Never populate by hand.
  ...(aggregateRating ? { aggregateRating } : {}),
};

// One Product + Offer per bookable experience — the simplest reliable path to
// price showing in search results. Offer URLs point at the dedicated landing
// pages, which carry their own richer Product schema (see ClassLanding.astro),
// so these summary products render on the homepage only.
//
// Derived from landings.ts rather than a local copy of the class data. Until
// Aug 2026 this was a hardcoded English array emitted on all five homepages,
// so /de/ and /fr/ shipped Product blocks named "The Chef's Table" whose Offer
// URLs pointed at the English landing pages. GSC showed 285 product-snippet
// impressions converting at 0.35%, worse than the site's plain results.
const HOMEPAGE_CLASS_KEYS: LandingKey[] = ['pasta-making', 'market-tour', 'private', 'online'];

const lang = getLocaleFromUrl(Astro.url);

const products = HOMEPAGE_CLASS_KEYS.flatMap((key) => {
  // Read through the declared type: `landings` uses `satisfies`, so indexing it
  // infers the one literal shape for that key, on which optional fields like
  // `product` may be absent rather than optional.
  const page: LandingPage = landings[key];
  const entry = page.locales[lang];
  const product = entry?.cl.product;
  if (!entry || !product) return [];
  return [
    {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      description: product.description,
      image: `${SITE}${entry.cl.image.src.src}`,
      brand: { '@type': 'Brand', name: 'Handmade Pasta Florence' },
      // Scoped to this class, matching the landing-page Products in
      // ClassLanding.astro. Each of these four is a distinct Product, so a
      // sitewide rating on all of them would claim every class had been
      // reviewed by everyone. The sitewide figure belongs on LocalBusiness
      // below, which is a rating of the business rather than of one class.
      ...(getAggregateRating(key) ? { aggregateRating: getAggregateRating(key) } : {}),
      ...(getReviewSchema(key) ? { review: getReviewSchema(key) } : {}),
      offers: {
        '@type': 'Offer',
        price: product.price,
        priceCurrency: 'EUR',
        availability: 'https://schema.org/InStock',
        priceValidUntil: PRICE_VALID_UNTIL,
        url: `${SITE}${landingPath(key, lang)}`,
      },
    },
  ];
});

// Derived from `locales` rather than a hardcoded path list, so adding a
// language to config.ts can't silently drop its homepage schema.
const isHome = locales.some(
  (l) => Astro.url.pathname === (l === defaultLocale ? '/' : `/${l}/`),
);
---

<script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
{isHome && products.map((p) => <script type="application/ld+json" set:html={JSON.stringify(p)} />)}
