---
import { Image } from 'astro:assets';
import iconRollingPin from '../assets/images/icons/why-rollingpin.avif';
import iconWineGlass from '../assets/images/icons/why-wine.avif';
import iconGroup from '../assets/images/icons/why-group.avif';
import iconDuomo from '../assets/images/icons/why-duomo.avif';

const icons: Record<string, ImageMetadata> = {
  rollingPin: iconRollingPin,
  wineGlass: iconWineGlass,
  group: iconGroup,
  duomo: iconDuomo,
};

import { getLocaleFromUrl } from '../i18n/utils';
import { useTranslations } from '../i18n/ui';
const t = useTranslations(getLocaleFromUrl(Astro.url));
// Icon order matches t.why.points; icons stay here (non-translatable markup).
const iconKeys = ['rollingPin', 'wineGlass', 'group', 'duomo'];
---

<section class="why" aria-label="Why cook with us">
  <h2 class="sr-only">{t.why.srHeading}</h2>
  <div class="shell why__grid">
    {t.why.points.map((p, i) => (
      <article class="why__item" data-reveal style={`--reveal-delay:${i * 80}ms`}>
        <div class="why__icon">
          <Image src={icons[iconKeys[i]]} alt="" class="why__icon-img" height={120} densities={[1, 1.5, 2]} />
        </div>
        <h3 class="why__t">{p.t}</h3>
        <p class="why__d">{p.d}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .why { padding-block: clamp(2.5rem, 6vh, 4.5rem); border-block: 1px solid var(--paper-line); background: #ffffff; }
  /* Keeps the h1 → h2 → h3 outline intact without a visible heading in this strip. */
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .why__grid {
    display: grid; gap: clamp(1.4rem, 3vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }
  .why__item {
    text-align: center;
  }
  .why__icon {
    display: inline-flex; place-items: center; justify-content: center; width: auto; height: 120px;
    margin-bottom: 1rem;
  }
  .why__icon-img { width: auto; height: 100%; object-fit: contain; }
  .why__t { font-size: var(--step-1); color: var(--olive); margin-bottom: 0.5rem; }
  .why__d { font-size: var(--step--1); color: var(--charcoal-soft); line-height: 1.6; }
  @media (min-width: 720px) {
    .why__item + .why__item { padding-left: clamp(1.4rem, 3vw, 2.5rem); border-left: 1px solid var(--paper-line); }
  }
</style>
