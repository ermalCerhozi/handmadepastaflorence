---
// The "all classes" hub. Every card is built from the landing's own locale data
// in src/data/landings.ts; the framing copy and grouping live in
// src/data/classes-hub.ts. See the SEO note there before retitling this page.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import BookingDrawer from '../components/BookingDrawer.astro';
import { landings, landingPath, type LandingKey, type LandingPage } from '../data/landings';
import { classesHub, classesPath } from '../data/classes-hub';
import { localizePath, SITE, type Alternate } from '../i18n/utils';
import { locales, type Locale } from '../i18n/config';
import { breadcrumbSchema } from '../utils/schema';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const h = classesHub[locale];
const t = useTranslations(locale);

const alternates: Alternate[] = locales.map((l) => ({ locale: l, path: classesPath(l) }));

// One card per landing that exists in this locale, in the group's order.
const groups = h.groups.map((g) => ({
  ...g,
  cards: g.keys.flatMap((key: LandingKey) => {
    const data = (landings[key] as LandingPage).locales[locale];
    if (!data) return [];
    return [{ key, href: landingPath(key, locale), data }];
  }),
}));
const allCards = groups.flatMap((g) => g.cards);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const breadcrumbLd = breadcrumbSchema([
  { name: t.lp.home, item: `${SITE}${localizePath('/', locale)}` },
  { name: h.crumb, item: canonical },
]);
// ItemList tells Google this page indexes the class pages below it.
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: h.title,
  itemListElement: allCards.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.data.cl.breadcrumbName,
    url: `${SITE}${c.href}`,
  })),
};

const ogImage = (landings['pasta-making'] as LandingPage).locales[locale]?.cl.image.src.src;
---

<Layout title={h.title} description={h.description} image={ogImage} alternates={alternates}>
  <Header solid alternates={alternates} />
  <main>
    <section class="ch-hero" id="top">
      <div class="shell ch-hero__intro">
        <nav class="ch-crumb" aria-label="Breadcrumb">
          <a href={localizePath('/', locale)}>{t.lp.home}</a>
          <span aria-hidden="true">&gt;</span> <span>{h.crumb}</span>
        </nav>
        <p class="eyebrow ch-hero__eyebrow">{h.eyebrow}</p>
        <h1 class="ch-hero__h">{h.heading} <span class="font-golden font-golden--accent font-golden--terracotta">{h.headingItal}</span></h1>
        <p class="ch-hero__lede">{h.lede}</p>
        <ul class="ch-jump">
          {groups.map((g) => (
            <li><a href={`#${g.id}`}>{g.title}</a></li>
          ))}
        </ul>
      </div>
    </section>

    {groups.map((g, gi) => (
      <section class={`ch-group${gi % 2 ? ' ch-group--alt' : ''}`} id={g.id}>
        <div class="shell">
          <header class="ch-group__head">
            <h2 class="ch-group__h" data-reveal>{g.title}</h2>
            <p class="ch-group__intro" data-reveal style="--reveal-delay:120ms">{g.intro}</p>
          </header>
          <div class="ch-grid">
            {g.cards.map(({ key, href, data }, i) => (
              <article class="ch-card" data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
                <div class="ch-card__media">
                  <Image
                    class="ch-card__img"
                    src={data.cl.image.src}
                    alt={data.cl.image.alt}
                    width={data.cl.image.w}
                    height={data.cl.image.h}
                    widths={[480, 640].filter((x) => x < data.cl.image.w).concat(data.cl.image.w)}
                    sizes="(min-width: 1100px) 380px, (min-width: 700px) 45vw, 92vw"
                    loading={gi === 0 && i < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <span class="ch-card__price">{data.cl.price}</span>
                </div>
                <div class="ch-card__body">
                  <p class="ch-card__kicker">{data.cl.eyebrow}</p>
                  {/* This link is stretched over the whole card by CSS. */}
                  <h3 class="ch-card__name"><a href={href} data-cta={`classes-hub-${key}`}>{data.cl.breadcrumbName}</a></h3>
                  <p class="ch-card__desc">{data.description}</p>
                  {data.cl.priceNote && <p class="ch-card__note">{data.cl.priceNote}</p>}
                  <span class="ch-card__go" aria-hidden="true">{h.cardCta} <span>→</span></span>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))}
  </main>
  <Footer />
  <FloatingCTA />
  <BookingDrawer />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListLd)} />
</Layout>

<style>
  /* Motion follows the rest of the site on purpose: the hero copy fades up from
     first paint like .lp-hero__intro (ClassLanding.astro), section heads and
     cards use [data-reveal] with the homepage stagger, and the card hover is the
     homepage .card (Experiences.astro): deeper shadow, slow photo zoom, name to
     terracotta, arrow sliding out. Change those first if this should differ. */
  .ch-hero { padding-block: clamp(7rem, 14vh, 10rem) clamp(2rem, 5vh, 3rem); background: var(--flour-deep); }
  .ch-hero__intro { animation: chHeroIn 0.9s var(--ease) both; }
  @keyframes chHeroIn {
    from { opacity: 0; transform: translateY(34px); }
  }
  .ch-crumb { font-size: var(--step--1); color: rgba(35,35,33,0.55); margin-bottom: 1.2rem; }
  .ch-crumb a { text-decoration: underline; text-underline-offset: 2px; }
  .ch-crumb span { margin-inline: 0.35rem; }
  .ch-hero__eyebrow { color: var(--terracotta); margin-bottom: 0.9rem; }
  .ch-hero__h { font-size: var(--step-3); color: var(--olive); max-width: 20ch; }
  .ch-hero__lede { margin-top: 1.2rem; max-width: 62ch; font-size: var(--step-0); line-height: 1.6; color: var(--charcoal-soft); }

  .ch-jump { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.6rem; }
  .ch-jump a {
    display: inline-block; padding: 0.5rem 0.95rem; border-radius: 100px;
    border: 1px solid var(--paper-line); background: var(--flour);
    font-size: var(--step--1); font-weight: 600; color: var(--olive);
    transition: background 0.3s, border-color 0.3s, color 0.3s;
  }
  .ch-jump a:hover { background: #fff; border-color: var(--yolk); color: var(--terracotta); }

  .ch-group { padding-block: clamp(2.5rem, 7vh, 4.5rem); scroll-margin-top: 4.5rem; }
  .ch-group--alt { background: var(--flour-deep); }
  .ch-group__head { display: grid; gap: 0.5rem; margin-bottom: clamp(1.4rem, 3vh, 2rem); }
  .ch-group__h { font-size: var(--step-2); color: var(--olive); }
  .ch-group__intro { color: var(--charcoal-soft); font-size: var(--step--1); max-width: 60ch; }

  .ch-grid { display: grid; gap: clamp(1.2rem, 2.5vw, 2rem); grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); }
  .ch-card {
    position: relative; display: flex; flex-direction: column; overflow: hidden; cursor: pointer;
    background: #fff; border-radius: var(--radius-lg);
    border: 1px solid var(--paper-line); box-shadow: var(--shadow-sm);
    /* Scoped CSS outranks the global [data-reveal] rule, so a bare box-shadow
       transition here would drop the reveal fade. Keep both, delay only the reveal. */
    transition:
      opacity 0.9s var(--ease) var(--reveal-delay, 0ms),
      transform 0.9s var(--ease) var(--reveal-delay, 0ms),
      box-shadow 0.5s var(--ease);
  }
  .ch-card:hover { box-shadow: var(--shadow-lg); }
  .ch-card__media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--flour-shadow); }
  .ch-card__img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.7s var(--ease);
  }
  .ch-card:hover .ch-card__img { transform: scale(1.07); }
  .ch-card__price {
    position: absolute; right: 0.9rem; bottom: 0.7rem;
    font-family: var(--serif); font-weight: 800; font-size: 1.35rem; color: #fff;
    text-shadow: 0 2px 14px rgba(0,0,0,0.55);
  }
  .ch-card__body { display: flex; flex-direction: column; flex: 1; gap: 0.45rem; padding: 1.2rem 1.3rem 1.4rem; }
  .ch-card__kicker { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--terracotta); }
  .ch-card__name { font-size: var(--step-1); color: var(--olive); }
  .ch-card__name a { color: inherit; transition: color 0.3s; }
  .ch-card:hover .ch-card__name a { color: var(--terracotta); }
  /* The name link is stretched over the whole card. */
  .ch-card__name a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .ch-card__name a:focus-visible { outline: none; }
  .ch-card:focus-within { outline: 3px solid var(--terracotta); outline-offset: 3px; }
  .ch-card__desc { font-size: var(--step--1); color: var(--charcoal-soft); line-height: 1.55; flex: 1; }
  .ch-card__note { font-size: 0.8rem; font-weight: 600; color: var(--olive-soft); }
  .ch-card__go {
    margin-top: 0.4rem; align-self: flex-start; display: inline-flex; align-items: center; gap: 0.5rem;
    font-weight: 700; font-size: var(--step--1); color: var(--olive);
    border-bottom: 2px solid var(--yolk); padding-bottom: 3px;
    transition: gap 0.35s var(--ease), color 0.3s;
  }
  .ch-card:hover .ch-card__go { gap: 0.9rem; color: var(--terracotta); }
</style>
