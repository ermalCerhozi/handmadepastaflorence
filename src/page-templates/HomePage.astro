---
// Homepage, shared by the English root (/) and every localized twin (/it/, …).
// The route files under src/pages/ are thin shims (getStaticPaths only); this
// template renders the sections, which each localize themselves from the URL.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhyUs from '../components/WhyUs.astro';
import Experiences from '../components/Experiences.astro';
import Reviews from '../components/Reviews.astro';
import PastaGallery from '../components/PastaGallery.astro';
import Story from '../components/Story.astro';
import OnlineBand from '../components/OnlineBand.astro';
import GiftBand from '../components/GiftBand.astro';
import B2b from '../components/B2b.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import BookingDrawer from '../components/BookingDrawer.astro';
import SectionDivider from '../components/SectionDivider.astro';
import { getLocaleFromUrl } from '../i18n/utils';
import { useTranslations } from '../i18n/ui';
import { reviews } from '../data/reviews';

const t = useTranslations(getLocaleFromUrl(Astro.url));
// The best three reviews go straight under the hero, the rest after the class
// cards, so you can't scroll far without passing one. Both blocks render nothing
// while src/data/reviews.ts is empty; order the array best-first.
---

<Layout title={t.meta.homeTitle} description={t.meta.homeDescription}>
  <Header />
  <main>
    <Hero />
    <Reviews items={reviews.slice(0, 3)} />
    <WhyUs />
    <SectionDivider />
    <Experiences />
    <Reviews items={reviews.slice(3)} id="more-reviews" head={false} showBadges={false} />
    <GiftBand />
    <PastaGallery />
    <Story />
    <OnlineBand />
    <B2b />
    <Faq />
  </main>
  <Footer />
  <FloatingCTA />
  <BookingDrawer />
</Layout>
