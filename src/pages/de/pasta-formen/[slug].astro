---
// German shape spokes: /de/pasta-formen/pici/ and friends.
import ShapePage from '../../../page-templates/ShapePage.astro';
import { shapes } from '../../../data/shapes';

export function getStaticPaths() {
  return shapes.de!.spokes.map((spoke) => ({
    params: { slug: spoke.slug },
    props: { spoke },
  }));
}

const { spoke } = Astro.props;
---

<ShapePage locale="de" spoke={spoke} />
