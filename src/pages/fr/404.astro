---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  noindex
  title="Page introuvable | Handmade Pasta Florence"
  description="Cette page a quitté la table. Retournez en cuisine."
>
  <main class="nf">
    <p class="nf__emoji" aria-hidden="true">🍝</p>
    <h1 class="nf__title">Perdu dans la farine</h1>
    <p class="nf__text">Cette page a quitté la table. Nous vous ramenons en cuisine.</p>
    <a href="/fr/" class="btn btn--solid nf__btn">Retour à l’accueil</a>
  </main>
</Layout>

<style>
  .nf {
    min-height: 72vh; display: grid; place-content: center; justify-items: center;
    gap: 1.1rem; text-align: center; padding: 4rem 1.5rem;
  }
  .nf__emoji { font-size: 3.5rem; margin: 0; }
  .nf__title { font-family: var(--serif); font-size: var(--step-3); color: var(--olive); margin: 0; }
  .nf__text { color: var(--charcoal-soft); max-width: 42ch; margin: 0; }
  .nf__btn { margin-top: 0.6rem; }
</style>
