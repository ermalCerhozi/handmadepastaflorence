---
// English shape spokes: /pasta-shapes/pici/ and friends.
import ShapePage from '../../page-templates/ShapePage.astro';
import { shapes } from '../../data/shapes';

export function getStaticPaths() {
  return shapes.en!.spokes.map((spoke) => ({
    params: { slug: spoke.slug },
    props: { spoke },
  }));
}

const { spoke } = Astro.props;
---

<ShapePage locale="en" spoke={spoke} />
