---
// Chinese shape spokes: /zh/yidali-mian-xingzhuang/pici/ and friends.
import ShapePage from '../../../page-templates/ShapePage.astro';
import { shapes } from '../../../data/shapes';

export function getStaticPaths() {
  return shapes.zh!.spokes.map((spoke) => ({
    params: { slug: spoke.slug },
    props: { spoke },
  }));
}

const { spoke } = Astro.props;
---

<ShapePage locale="zh" spoke={spoke} />
